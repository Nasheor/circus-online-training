---
import PageHero from '../../../components/PageHero.astro';
import { localePaths } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import { href } from '../../../i18n/href';
import { getStrings } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = localePaths;

const locale = Astro.params.locale as Locale;
const s = getStrings(locale);
const t = s.glossary;
const terms = [...t.terms].sort((a, b) => a.term.localeCompare(b.term, locale));
---

<Base locale={locale} title={t.title} section="library" path="library/glossary">
  <PageHero
    title={t.title}
    lead={t.lead}
    breadcrumbLabel={s.common.breadcrumb}
    crumbs={[
      { label: s.nav.home, href: href(locale) },
      { label: s.nav.library, href: href(locale, 'library') },
      { label: t.title },
    ]}
  />
  <div class="container section">
    <dl class="glossary">
      {
        terms.map((entry) => (
          <div>
            <dt>{entry.term}</dt>
            <dd>{entry.definition}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</Base>

<style>
  .glossary {
    max-width: 52rem;
    margin: 0;
  }
  .glossary > div {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }
  dt {
    font-weight: 800;
    color: var(--navy-deep);
  }
  dd {
    margin: var(--space-1) 0 0;
  }
</style>
