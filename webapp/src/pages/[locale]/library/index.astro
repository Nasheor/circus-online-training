---
import PageHero from '../../../components/PageHero.astro';
import ResourceLink from '../../../components/ResourceLink.astro';
import { RESOURCES } from '../../../content/resources';
import { localePaths } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import { href } from '../../../i18n/href';
import { getStrings } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = localePaths;

const locale = Astro.params.locale as Locale;
const s = getStrings(locale);
const t = s.library;

const originals = [
  { title: t.groups.cards, ids: ['manual-wattworks', 'cards-intro-outro', 'cards-phase-1-awareness', 'cards-phase-2-exploring', 'cards-phase-3-collaboration'] },
  { title: t.groups.tool1, ids: ['energy-profile-tool-1a-v1.03', 'manual-energy-profile-tool'] },
  { title: t.groups.tool2, ids: ['manual-gis-tool'] },
  { title: t.groups.tool3, ids: ['business-tool', 'manual-business-tool'] },
];
const listed = new Set(originals.flatMap((group) => group.ids));
// Everything not shipped with the site, grouped by where it is hosted, so a new manifest entry shows up here by itself.
const external = RESOURCES.filter((resource) => !listed.has(resource.id) && !resource.local);
const partner = [
  { title: t.foldersTitle, items: external.filter((resource) => resource.kind === 'page' || resource.id.startsWith('drive-')) },
  { title: t.mapsTitle, items: external.filter((resource) => resource.kind === 'map') },
  { title: t.businessTitle, items: external.filter((resource) => resource.kind === 'folder' && !resource.id.startsWith('drive-')) },
];
---

<Base locale={locale} title={t.title} section="library" path="library">
  <PageHero
    title={t.title}
    lead={t.lead}
    breadcrumbLabel={s.common.breadcrumb}
    crumbs={[{ label: s.nav.home, href: href(locale) }, { label: s.nav.library }]}
  >
    <div><a class="btn" href={href(locale, 'library/glossary')}>{t.glossaryLink}</a></div>
  </PageHero>
  <div class="container section stack-lg">
    <section class="stack">
      <h2>{t.originalsTitle}</h2>
      <p>{t.originalsLead}</p>
      <div class="grid grid--wide">
        {
          originals.map((group) => (
            <div class="panel panel--flat">
              <h3>{group.title}</h3>
              <ul>
                {group.ids.map((id) => (
                  <li>
                    <ResourceLink locale={locale} id={id} label={t.items[id]} />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
    <section class="stack">
      <h2>{t.partnerTitle}</h2>
      <p>{t.partnerLead}</p>
      <div class="grid grid--wide">
        {
          partner.map((group) => (
            <div class="panel panel--flat">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((resource) => (
                  <li>
                    <ResourceLink locale={locale} id={resource.id} label={t.items[resource.id] ?? resource.id} />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<style>
  h3 {
    font-size: var(--text-lg);
  }
</style>
