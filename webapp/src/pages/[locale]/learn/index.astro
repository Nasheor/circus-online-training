---
import PageHero from '../../../components/PageHero.astro';
import { LESSONS } from '../../../content/lessons';
import { localePaths } from '../../../i18n/config';
import type { Locale } from '../../../i18n/config';
import { fill } from '../../../i18n/format';
import { href } from '../../../i18n/href';
import { getStrings } from '../../../i18n/strings';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = localePaths;

const locale = Astro.params.locale as Locale;
const s = getStrings(locale);
const t = s.learn;
---

<Base locale={locale} title={t.title} section="learn" path="learn">
  <PageHero
    title={t.title}
    lead={t.lead}
    breadcrumbLabel={s.common.breadcrumb}
    crumbs={[{ label: s.nav.home, href: href(locale) }, { label: s.nav.learn }]}
  />
  <section class="section">
    <div class="container stack-lg">
      <div>{t.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
      <ol class="grid grid--wide lesson-list">
        {
          LESSONS.map((lesson, index) => (
            <li data-phase={lesson.phase}>
              <a class="panel panel--phase" href={href(locale, `learn/${lesson.id}`)}>
                <p class="eyebrow">{fill(t.lessonLabel, { n: index + 1 })}</p>
                <h2>{t.lessons[lesson.id].title}</h2>
                <p>{t.lessons[lesson.id].intro}</p>
                <p class="small muted">{fill(s.common.minutes, { n: t.lessons[lesson.id].minutes })}</p>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .lesson-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .lesson-list li {
    margin: 0;
    max-width: none;
    display: flex;
  }
  .lesson-list a {
    flex: 1;
  }
  .lesson-list h2 {
    font-size: var(--text-xl);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
  }
</style>
