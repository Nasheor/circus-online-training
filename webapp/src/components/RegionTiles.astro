---
import { REGIONS } from '../content/regions';
import type { Locale } from '../i18n/config';
import { fill } from '../i18n/format';
import { href } from '../i18n/href';
import { getStrings } from '../i18n/strings';

interface Props {
  locale: Locale;
  /** The region whose guide is open: marked as the current page. */
  current?: string;
  /** Smaller tiles, without the area line (for "Other regions" under a guide). */
  compact?: boolean;
}

const { locale, current, compact = false } = Astro.props;
const s = getStrings(locale);
const t = s.map;
const text = (id: string) => t.regions[id as keyof typeof t.regions];
// the country code is the first part of the region id (fr, be, nl-altena, ie, de-…)
const country = (id: string) => id.split('-')[0].toUpperCase();
---

<ul class:list={['regions', compact && 'regions--compact']} data-phase="p2">
  {
    REGIONS.map((region) => (
      <li>
        <a
          class="region"
          href={href(locale, `tools/map/${region.id}`)}
          aria-current={region.id === current ? 'page' : undefined}
        >
          <span class="region__code" aria-hidden="true">{country(region.id)}</span>
          <span class="region__name">{text(region.id).name}</span>
          {!compact && <span class="region__area">{text(region.id).area}</span>}
          {!compact && (
            <span class="region__meta">
              {region.layers.length === 1 ? t.layerCountOne : fill(t.layerCount, { n: region.layers.length })}
              {region.hasFeedback && <> · {t.feedbackTag}</>}
            </span>
          )}
          {!compact && <span class="region__go">{t.openRegion} →</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* Region tiles (2026-11-11 page pass): a large country code in the phase colour, the region, its map facts. */
  .regions {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-16);
  }
  .regions--compact {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
    gap: var(--s-12);
  }
  .regions li {
    margin: 0;
    max-width: none;
    display: flex;
  }
  .region {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
    padding: var(--s-24);
    border: 1px solid var(--border);
    border-top: 4px solid var(--phase);
    border-radius: var(--r-14);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .region:hover {
    transform: translateY(-3px);
    border-color: var(--phase);
  }
  .region[aria-current] {
    background: var(--phase);
    border-color: var(--phase);
    color: var(--phase-ink);
    --focus: var(--phase-ink);
  }
  .region__code {
    font-size: var(--t-big);
    font-weight: 750;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--phase-strong);
    margin-bottom: var(--s-8);
  }
  .region[aria-current] .region__code {
    color: inherit;
    opacity: 0.6;
  }
  .region__name {
    font-size: var(--t-22);
    font-weight: 700;
    line-height: 1.2;
  }
  .region__area {
    color: var(--muted);
  }
  .region__meta {
    font-size: var(--t-14);
    font-weight: 600;
    margin-top: var(--s-8);
  }
  .region__go {
    margin-top: auto;
    padding-top: var(--s-16);
    font-weight: 600;
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.2em;
  }
  .regions--compact .region {
    padding: var(--s-16);
  }
  .regions--compact .region__code {
    font-size: var(--t-28);
    margin-bottom: var(--s-4);
  }
  .regions--compact .region__name {
    font-size: var(--t-16);
  }
  @media (prefers-reduced-motion: reduce) {
    .region {
      transition: none;
    }
    .region:hover {
      transform: none;
    }
  }
</style>
