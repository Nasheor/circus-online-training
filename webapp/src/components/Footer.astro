---
import type { Locale } from '../i18n/config';
import { href } from '../i18n/href';
import { getStrings } from '../i18n/strings';
import { getResource } from '../content/resources';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = getStrings(locale);
const projectSite = getResource('circus-website').external;
---

<footer class="site-footer">
  <div class="container">
    <nav class="site-footer__links" aria-label={s.footer.label}>
      <ul>
        <li><a href={href(locale, 'about')}>{s.nav.about}</a></li>
        <li><a href={href(locale, 'about/privacy')}>{s.footer.privacy}</a></li>
        <li><a href={href(locale, 'about/accessibility')}>{s.footer.accessibility}</a></li>
        <li><a href={href(locale, 'about/feedback')}>{s.footer.feedback}</a></li>
        <li><a href={projectSite} rel="noopener">{s.footer.projectSite}</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  /* Links only (user, 2026-11-10): the wordmark, funding block, data note, version and partner logos were removed.
     The Interreg logo, funding statement and disclaimer remain on the About page. */
  .site-footer {
    margin-top: var(--s-72);
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: var(--s-32);
  }
  .site-footer__links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    text-align: center;
    gap: var(--s-8) var(--s-32);
  }
  .site-footer__links li {
    margin: 0;
  }
  .site-footer__links a {
    font-weight: 600;
    display: inline-block;
    padding-block: var(--s-4);
  }
</style>
