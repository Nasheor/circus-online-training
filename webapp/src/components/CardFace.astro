---
import type { CardDef } from '../content/structure';
import type { Locale } from '../i18n/config';
import { fill } from '../i18n/format';
import { getStrings } from '../i18n/strings';

interface Props {
  locale: Locale;
  card: CardDef;
}

const { locale, card } = Astro.props;
const s = getStrings(locale);
const text = s.cards[card.id];
---

<article class:list={['wcard', card.kind === 'info' && 'wcard--info']} data-phase={card.deck} id={card.id}>
  <div class="wcard__top">
    <span class="wcard__category">{s.cardCategories[card.category]}</span>
    {card.number !== null && <span class="wcard__number">{card.number}</span>}
  </div>
  {text.title && <h4 class="wcard__title">{text.title}</h4>}
  <ul class="wcard__lines">
    {text.lines.map((line) => <li>{line}</li>)}
  </ul>
  {
    card.methodologyId && (
      <p class="wcard__tag">{fill(s.wattworks.methodologyTag, { name: s.methodologies[card.methodologyId] })}</p>
    )
  }
</article>
